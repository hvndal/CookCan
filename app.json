{
  "expo": {
    "name": "CookCan",
    "slug": "cookcan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cookcan",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF9F5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cookcan.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "CookCan uses the camera to scan ingredients for personalized recipes.",
        "NSPhotoLibraryUsageDescription": "CookCan uses your photos to identify ingredients."
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FBF9F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cookcan.app",
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.cookcan.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F5",
          "image": "./assets/splash.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CookCan to access your camera to scan ingredients.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CookCan to access your photos to identify ingredients."
        }
      ],
      "expo-iap",
      "expo-image",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      },
      "privacyPolicyUrl": "https://cookcan.app/privacy",
      "termsUrl": "https://cookcan.app/terms",
      "supportEmail": "support@cookcan.app"
    }
  }
}

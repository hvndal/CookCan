# GEMINI_API_KEY: Required for Gemini AI API calls (scan, recipes, AI Chef).
# Prefer EXPO_PUBLIC_GEMINI_API_KEY for the Expo client.
GEMINI_API_KEY=MY_GEMINI_API_KEY
EXPO_PUBLIC_GEMINI_API_KEY=MY_GEMINI_API_KEY

# Firebase (Auth + Firestore) — see FIREBASE.md
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
# Comma-separated emails that can open Admin → Grant Pro
EXPO_PUBLIC_ADMIN_EMAILS=you@example.com

# Google Play subscription product IDs (SKUs) — create these in Play Console
# EXPO_PUBLIC_PRO_MONTHLY_PRODUCT_ID=cookcan_pro_monthly
# EXPO_PUBLIC_PRO_YEARLY_PRODUCT_ID=cookcan_pro_yearly
# Attach a 7-day free trial offer on both products.

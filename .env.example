# GEMINI_API_KEY: Required for Gemini AI API calls (scan, recipes, AI Chef).
# Prefer EXPO_PUBLIC_GEMINI_API_KEY for the Expo client.
GEMINI_API_KEY=MY_GEMINI_API_KEY
EXPO_PUBLIC_GEMINI_API_KEY=MY_GEMINI_API_KEY

# Supabase auth (optional — app supports local guest sessions without these)
EXPO_PUBLIC_SUPABASE_URL=https://oczdxcayqkwvriwolclh.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Play subscription product IDs (SKUs) — create these in Play Console
# EXPO_PUBLIC_PRO_MONTHLY_PRODUCT_ID=cookcan_pro_monthly
# EXPO_PUBLIC_PRO_YEARLY_PRODUCT_ID=cookcan_pro_yearly
# Attach a 7-day free trial offer on both products.
